 67.3}, {"w": "que", "s": 67.3, "e": 67.43}, {"w": "un", "s": 67.43, "e": 67.57}, {"w": "QR", "s": 67.57, "e": 67.71}, {"w": "deja", "s": 67.71, "e": 67.98}, {"w": "de", "s": 67.98, "e": 68.11}, {"w": "funcionar", "s": 68.11, "e": 68.52}, {"w": "apenas", "s": 68.52, "e": 68.93}, {"w": "se", "s": 68.93, "e": 69.07}, {"w": "raya.", "s": 69.07, "e": 69.34, "f": true}], "clauses": [{"p": 0, "t": "Este código QR puede tener una parte dañada y aun así funcionar.", "end": true, "w": 24, "s": 0.129819, "e": 3.3526759999999998, "snap": true}, {"p": 0, "t": "¿Cómo puede tu celular leer información que parece faltar?", "end": true, "w": 19, "s": 3.87517, "e": 6.605623, "snap": true}, {"p": 1, "t": "La respuesta está en una tecnología llamada corrección de errores.", "end": true, "w": 23, "s": 7.06619, "e": 10.631003, "snap": true}, {"p": 2, "t": "Para entenderla,", "end": false, "w": 6, "s": 11.0742, "e": 11.795503, "snap": true}, {"p": 2, "t": "primero tenés que saber que un QR almacena información mediante pequeños módulos blancos y negros organizados en una cuadrícula.", "end": true, "w": 45, "s": 11.9187, "e": 19.252789, "snap": true}, {"p": 3, "t": "Cuando apuntás con la cámara,", "end": false, "w": 10, "s": 19.5839, "e": 20.813544999999998, "snap": true}, {"p": 3, "t": "el celular identifica los patrones de las esquinas y analiza la distribución de esos módulos para reconstruir los datos.", "end": true, "w": 42, "s": 20.9835, "e": 26.995405, "snap": true}, {"p": 4, "t": "Pero el código también contiene información adicional que permite recuperar parte de los datos que no se pudieron leer.", "end": true, "w": 40, "s": 27.3118, "e": 33.618241000000005, "snap": true}, {"p": 5, "t": "Por eso,", "end": false, "w": 3, "s": 33.8584, "e": 34.31721050862069, "snap": false}, {"p": 5, "t": "si está rayado,", "end": false, "w": 6, "s": 34.31721050862069, "e": 34.85219, "snap": true}, {"p": 5, "t": "sucio o tiene una pequeña zona tapada,", "end": false, "w": 15, "s": 35.0077, "e": 37.191348, "snap": true}, {"p": 5, "t": "todavía puede funcionar.", "end": true, "w": 8, "s": 37.4484, "e": 38.658548, "snap": true}, {"p": 5, "t": "Sin embargo,", "end": false, "w": 4, "s": 39.0095, "e": 39.646117999999994, "snap": true}, {"p": 5, "t": "no significa que sea indestructible:", "end": false, "w": 12, "s": 39.858, "e": 41.630663, "snap": true}, {"p": 5, "t": "la capacidad de recuperación depende del nivel de corrección utilizado y de qué parte esté dañada.", "end": true, "w": 36, "s": 41.9703, "e": 46.799428999999996, "snap": true}, {"p": 6, "t": "Una vez que el teléfono consigue interpretar los datos,", "end": false, "w": 19, "s": 47.208, "e": 49.571062, "snap": true}, {"p": 6, "t": "puede descubrir un mensaje,", "end": false, "w": 9, "s": 49.8285, "e": 51.257476000000004, "snap": true}, {"p": 6, "t": "información de contacto o una dirección web.", "end": true, "w": 15, "s": 51.4187, "e": 53.698844, "snap": true}, {"p": 7, "t": "Lo sorprendente es que todo esto sucede en segundos,", "end": false, "w": 18, "s": 53.9822, "e": 56.209066, "snap": true}, {"p": 7, "t": "sin que tengas que entender qué significa cada cuadrado.", "end": true, "w": 18, "s": 56.3463, "e": 58.820548, "snap": true}, {"p": 8, "t": "No es magia.", "end": true, "w": 4, "s": 59.1798, "e": 59.820566, "snap": true}, {"p": 8, "t": "Es información codificada con un sistema preparado para detectar y corregir ciertos errores.", "end": true, "w": 33, "s": 60.1334, "e": 64.667298, "snap": true}, {"p": 9, "t": "Sígueme y envíaselo a ese amigo que piensa que un QR deja de funcionar apenas se raya.", "end": true, "w": 32, "s": 64.9824, "e": 69.339746, "snap": false}], "par_start": [0.13, 7.07, 11.07, 19.58, 27.31, 33.86, 47.21, 53.98, 59.18, 64.98], "dur": 69.464}